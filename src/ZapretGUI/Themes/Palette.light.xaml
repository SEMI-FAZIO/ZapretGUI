<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="BgDeepColor">#E9ECF3</Color>
    <Color x:Key="BgColor">#F4F6FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceElevatedColor">#FAFBFF</Color>
    <Color x:Key="SurfaceHoverColor">#EFF1F8</Color>
    <Color x:Key="SurfaceActiveColor">#E4E8F4</Color>
    <Color x:Key="BorderColor">#DDE2EF</Color>
    <Color x:Key="BorderStrongColor">#BFC6D9</Color>
    <Color x:Key="DividerColor">#E6EAF3</Color>

    <!-- Text -->
    <Color x:Key="TextColor">#0F1530</Color>
    <Color x:Key="TextMutedColor">#5B6378</Color>
    <Color x:Key="TextSubtleColor">#8089A0</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

    <!-- Brand accent -->
    <Color x:Key="AccentColor">#6845FF</Color>
    <Color x:Key="AccentHoverColor">#7C5CFF</Color>
    <Color x:Key="AccentPressedColor">#5736E8</Color>
    <Color x:Key="AccentSoftColor">#ECE6FF</Color>

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#15A05F</Color>
    <Color x:Key="SuccessSoftColor">#DFF5E9</Color>
    <Color x:Key="WarningColor">#C8841A</Color>
    <Color x:Key="WarningSoftColor">#FBEBCB</Color>
    <Color x:Key="DangerColor">#D5384A</Color>
    <Color x:Key="DangerSoftColor">#FBE0E4</Color>
    <Color x:Key="InfoColor">#2A75D1</Color>
    <Color x:Key="InfoSoftColor">#DCEAFB</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgDeepBrush"          Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="BgBrush"              Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush"         Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush"    Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceActiveBrush"   Color="{StaticResource SurfaceActiveColor}" />
    <SolidColorBrush x:Key="BorderBrush"          Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush"    Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="DividerBrush"         Color="{StaticResource DividerColor}" />

    <SolidColorBrush x:Key="TextBrush"            Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush"       Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextSubtleBrush"      Color="{StaticResource TextSubtleColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush"    Color="{StaticResource TextOnAccentColor}" />

    <SolidColorBrush x:Key="AccentBrush"          Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush"     Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush"   Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush"      Color="{StaticResource AccentSoftColor}" />

    <SolidColorBrush x:Key="SuccessBrush"         Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush"     Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush"         Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush"     Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush"          Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush"      Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="InfoBrush"            Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSoftBrush"        Color="{StaticResource InfoSoftColor}" />

    <!-- Gradients -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C5CFF" Offset="0" />
        <GradientStop Color="#4D7BFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2EEFF" Offset="0" />
        <GradientStop Color="#E6EEFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Typography -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Inter</FontFamily>
    <FontFamily x:Key="HeadingFont">Segoe UI Variable Display, Segoe UI, Inter</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
