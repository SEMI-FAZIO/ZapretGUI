<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="BgDeepColor">#0B0D12</Color>
    <Color x:Key="BgColor">#10131A</Color>
    <Color x:Key="SurfaceColor">#161A24</Color>
    <Color x:Key="SurfaceElevatedColor">#1C2030</Color>
    <Color x:Key="SurfaceHoverColor">#232838</Color>
    <Color x:Key="SurfaceActiveColor">#2A3045</Color>
    <Color x:Key="BorderColor">#262C3D</Color>
    <Color x:Key="BorderStrongColor">#374060</Color>
    <Color x:Key="DividerColor">#1F2433</Color>

    <!-- Text -->
    <Color x:Key="TextColor">#E7EAF5</Color>
    <Color x:Key="TextMutedColor">#9098B3</Color>
    <Color x:Key="TextSubtleColor">#5F6885</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

    <!-- Brand accent (violet → blue) -->
    <Color x:Key="AccentColor">#7C5CFF</Color>
    <Color x:Key="AccentHoverColor">#8E72FF</Color>
    <Color x:Key="AccentPressedColor">#6849F0</Color>
    <Color x:Key="AccentSoftColor">#2A2148</Color>

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#3DD68C</Color>
    <Color x:Key="SuccessSoftColor">#143527</Color>
    <Color x:Key="WarningColor">#F4B23B</Color>
    <Color x:Key="WarningSoftColor">#3A2E13</Color>
    <Color x:Key="DangerColor">#F0606E</Color>
    <Color x:Key="DangerSoftColor">#3A1B22</Color>
    <Color x:Key="InfoColor">#5DB2FF</Color>
    <Color x:Key="InfoSoftColor">#13283F</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgDeepBrush"          Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="BgBrush"              Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush"         Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush"    Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceActiveBrush"   Color="{StaticResource SurfaceActiveColor}" />
    <SolidColorBrush x:Key="BorderBrush"          Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush"    Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="DividerBrush"         Color="{StaticResource DividerColor}" />

    <SolidColorBrush x:Key="TextBrush"            Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush"       Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextSubtleBrush"      Color="{StaticResource TextSubtleColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush"    Color="{StaticResource TextOnAccentColor}" />

    <SolidColorBrush x:Key="AccentBrush"          Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush"     Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush"   Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush"      Color="{StaticResource AccentSoftColor}" />

    <SolidColorBrush x:Key="SuccessBrush"         Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush"     Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush"         Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush"     Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush"          Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush"      Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="InfoBrush"            Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSoftBrush"        Color="{StaticResource InfoSoftColor}" />

    <!-- Gradient for accent surfaces -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5BFF" Offset="0" />
        <GradientStop Color="#4D7BFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1B1839" Offset="0" />
        <GradientStop Color="#13182B" Offset="1" />
    </LinearGradientBrush>

    <!-- Typography -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Inter</FontFamily>
    <FontFamily x:Key="HeadingFont">Segoe UI Variable Display, Segoe UI, Inter</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
