<UserControl x:Class="ZapretGUI.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="36,28,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Logs.Title}" Style="{StaticResource H1}" />
            <TextBlock Text="{DynamicResource Logs.Subtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Entries.Count, StringFormat='{}{0} строк'}" Margin="10,0,0,0" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource SegmentContainer}" Margin="0,0,12,0">
                    <UniformGrid Columns="3">
                        <RadioButton GroupName="Src" Style="{StaticResource SegmentRadio}" Content="Все" Click="OnFilterAll" IsChecked="True" />
                        <RadioButton GroupName="Src" Style="{StaticResource SegmentRadio}" Content="winws" Click="OnFilterWinws" />
                        <RadioButton GroupName="Src" Style="{StaticResource SegmentRadio}" Content="SCM" Click="OnFilterService" />
                    </UniformGrid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource Logs.AutoScroll}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoScroll, Mode=TwoWay}" />
                </StackPanel>

                <Button Grid.Column="3" Style="{StaticResource GhostButton}" Click="OnPauseToggle" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PauseIcon" Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock x:Name="PauseText" Text="{DynamicResource Logs.Pause}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Style="{StaticResource GhostButton}" Command="{Binding LoadServiceEventsCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="События SCM" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="5" Style="{StaticResource ButtonBase}" Command="{Binding SaveCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Logs.Save}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="6" Style="{StaticResource DangerButton}" Command="{Binding ClearCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Logs.Clear}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Log viewer -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Entries.Count, Converter={StaticResource CountToVis}, ConverterParameter=empty}">
                    <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="24"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource Logs.Empty}" HorizontalAlignment="Center" Style="{StaticResource Caption}"
                               Margin="0,14,0,0" TextAlignment="Center" MaxWidth="420" />
                </StackPanel>

                <ScrollViewer x:Name="LogsScroll" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding Entries.Count, Converter={StaticResource CountToVis}}">
                    <ItemsControl ItemsSource="{Binding View}" Margin="14,12,14,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                               Foreground="{StaticResource TextSubtleBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Level}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source}" Value="Service">
                                                        <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Text}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                                               Foreground="{StaticResource TextBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
