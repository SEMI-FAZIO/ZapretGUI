<UserControl x:Class="ZapretGUI.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:ZapretGUI.Services"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,28" MaxWidth="980" HorizontalAlignment="Stretch">

            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{DynamicResource Settings.Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{DynamicResource Settings.Subtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Version -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Settings.Version}" Style="{StaticResource H3}" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0">
                            <Run Text="{DynamicResource Settings.Installed}" />
                            <Run Text=" " /><Run Text="{Binding LocalVersion, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="{Binding VersionStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Command="{Binding OpenReleaseCommand}" Margin="0,0,8,0"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Settings.OpenRelease}" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding CheckUpdateCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Settings.CheckUpdate}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Auto-update toggle -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Settings.AutoUpdate}" Style="{StaticResource H3}" />
                        <TextBlock Text="{DynamicResource Settings.AutoUpdateHint}"
                                   Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="640" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding AutoUpdate, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ISP fingerprint (ZDefree.Core IspDetector) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings.Isp}" Style="{StaticResource H3}" />
                            <TextBlock Text="{DynamicResource Settings.Isp.Hint}"
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="640" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Command="{Binding DetectIspCommand}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource Settings.Isp.Detect}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDetectingIsp}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Settings.Isp.Detecting}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="{DynamicResource Settings.Isp.NotDetected}"
                               Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Visibility="{Binding HasIspInfo, Converter={StaticResource BoolToVis}, ConverterParameter=invert, FallbackValue=Visible}" />

                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding IspError, Converter={StaticResource StringEmpty}, FallbackValue=Collapsed}">
                        <Run Text="{DynamicResource Settings.Isp.Error}" /><Run Text=": " /><Run Text="{Binding IspError, Mode=OneWay}" />
                    </TextBlock>

                    <Grid Margin="0,8,0,0"
                          Visibility="{Binding HasIspInfo, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings.Isp.Ip}"        Style="{StaticResource MicroCaption}" Margin="0,2,12,2" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IspIp}"                          Style="{StaticResource Body}"        Margin="0,2,0,2" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings.Isp.Country}"   Style="{StaticResource MicroCaption}" Margin="0,2,12,2" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IspCountry, FallbackValue=—}"    Style="{StaticResource Body}"        Margin="0,2,0,2" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings.Isp.Asn}"       Style="{StaticResource MicroCaption}" Margin="0,2,12,2" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IspAsn, FallbackValue=—}"        Style="{StaticResource Body}"        Margin="0,2,0,2" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Settings.Isp.Org}"       Style="{StaticResource MicroCaption}" Margin="0,2,12,2" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding IspOrg, FallbackValue=—}"        Style="{StaticResource Body}"        Margin="0,2,0,2" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Settings.Isp.CompatTag}" Style="{StaticResource MicroCaption}" Margin="0,2,12,2" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IspCompatTag, FallbackValue=—}"  Style="{StaticResource Body}"        Margin="0,2,0,2" FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Behavior -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Behavior}" Style="{StaticResource H3}" Margin="0,0,0,8" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings.StartWithWindows}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Settings.StartWithWindowsHint}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="640" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings.StartMinimized}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding StartMinimized, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings.AutoStartBypass}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Settings.AutoStartBypassHint}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="640" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding AutoStartBypass, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Захват логов winws.exe" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="Вывод процесса будет попадать на вкладку «Логи». Отключите, если хотите видеть стандартное окно winws."
                                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="640" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding CaptureWinwsLogs, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Appearance}" Style="{StaticResource H3}" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings.Theme}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource SegmentContainer}">
                            <UniformGrid Columns="3">
                                <RadioButton GroupName="Theme" Style="{StaticResource SegmentRadio}"
                                             Content="{DynamicResource Settings.Theme.Dark}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConv}, ConverterParameter=Dark, Mode=OneWay}"
                                             Click="OnThemeDark" />
                                <RadioButton GroupName="Theme" Style="{StaticResource SegmentRadio}"
                                             Content="{DynamicResource Settings.Theme.Light}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConv}, ConverterParameter=Light, Mode=OneWay}"
                                             Click="OnThemeLight" />
                                <RadioButton GroupName="Theme" Style="{StaticResource SegmentRadio}"
                                             Content="{DynamicResource Settings.Theme.System}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConv}, ConverterParameter=System, Mode=OneWay}"
                                             Click="OnThemeSystem" />
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings.Language}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource SegmentContainer}">
                            <UniformGrid Columns="3">
                                <RadioButton GroupName="Lang" Style="{StaticResource SegmentRadio}" Content="Русский"
                                             IsChecked="{Binding Language, Converter={StaticResource EqualsConv}, ConverterParameter=Ru, Mode=OneWay}"
                                             Click="OnLangRu" />
                                <RadioButton GroupName="Lang" Style="{StaticResource SegmentRadio}" Content="English"
                                             IsChecked="{Binding Language, Converter={StaticResource EqualsConv}, ConverterParameter=En, Mode=OneWay}"
                                             Click="OnLangEn" />
                                <RadioButton GroupName="Lang" Style="{StaticResource SegmentRadio}"
                                             Content="{DynamicResource Settings.Theme.System}"
                                             IsChecked="{Binding Language, Converter={StaticResource EqualsConv}, ConverterParameter=System, Mode=OneWay}"
                                             Click="OnLangSystem" />
                            </UniformGrid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Paths -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Paths}" Style="{StaticResource H3}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings.ZapretRoot}" Style="{StaticResource MicroCaption}" />
                            <TextBlock Text="{Binding ZapretRoot}" Style="{StaticResource Body}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding ChangePathCommand}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Settings.ChangePath}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Common.Open}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Command="{Binding OpenLogsCommand}" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Settings.Logs}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Backup / Restore -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Бэкап / восстановление" Style="{StaticResource H3}" />
                        <TextBlock Text="Сохраняет настройки GUI и пользовательские списки в .zip. Не включает winws.exe и WinDivert."
                                   Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="640" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Command="{Binding ImportBackupCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="Восстановить" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding ExportBackupCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="Создать бэкап" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentGradientBrush}">
                        <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="32"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Zapret GUI" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="GUI " /><Run Text="{Binding GuiVersion, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="    •    zapret " /><Run Text="{Binding LocalVersion, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Text="{DynamicResource Settings.AboutText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource ButtonBase}" Command="{Binding OpenRepoCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Settings.GitHub}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
