<UserControl x:Class="ZapretGUI.Views.StrategiesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="36,28,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Strategies.Title}" Style="{StaticResource H1}" />
            <TextBlock Text="{DynamicResource Strategies.Subtitle}"
                       Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12,0" Height="40" MaxWidth="380" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Width="280" Margin="10,0,0,0"
                             FontFamily="{StaticResource UiFont}"
                             VerticalAlignment="Center" VerticalContentAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SegmentContainer}" Margin="12,0,0,0">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="Cat" Style="{StaticResource SegmentRadio}"
                                         Content="{Binding}"
                                         IsChecked="{Binding DataContext.FilterCategory,
                                                     RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                     Converter={StaticResource EqualsConv}, ConverterParameter=ВСЕ, Mode=OneWay}"
                                         Click="OnCategoryClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                    Command="{Binding RefreshCommand}" ToolTip="Обновить список .bat файлов">
                <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="13" />
            </Button>
        </Grid>

        <!-- Two-pane content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Strategies list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <ListBox ItemsSource="{Binding Filtered}"
                         SelectedItem="{Binding SelectedStrategy, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="10"
                                                Padding="14,10">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource BadgeText}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Right panel -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding SelectedStrategy.Category, FallbackValue=—}" Style="{StaticResource MicroCaption}" />
                        <TextBlock Text="{Binding SelectedStrategy.DisplayName, FallbackValue=Стратегия не выбрана}"
                                   Style="{StaticResource H2}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedStrategy.Description}"
                                   Style="{StaticResource Body}" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding SelectedStrategy.FileName, StringFormat='Файл: {0}'}"
                                   Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,18,0,12" Height="1" Background="{StaticResource DividerBrush}" />

                    <!-- Args preview / Diff with general.bat -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Strategies.Args}" Style="{StaticResource H3}"
                                       Visibility="{Binding Diff, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                            <TextBlock Grid.Column="0" Text="Отличия от general.bat" Style="{StaticResource H3}"
                                       Visibility="{Binding Diff, Converter={StaticResource NullToVis}}" />
                            <TextBlock Grid.Column="1" Text="{Binding DiffSummary}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding ToggleDiffCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Сравнить с general" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Plain args -->
                        <Border Grid.Row="1" Background="{StaticResource BgDeepBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10"
                                Visibility="{Binding Diff, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6">
                                <TextBox Text="{Binding PreviewArgs, Mode=OneWay}" IsReadOnly="True"
                                         Background="Transparent" BorderThickness="0"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <!-- Diff view -->
                        <Border Grid.Row="1" Background="{StaticResource BgDeepBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10"
                                Visibility="{Binding Diff, Converter={StaticResource NullToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Diff}" Margin="6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4"
                                                        Background="{Binding Kind, Converter={StaticResource DiffBrush}}"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Kind, Converter={StaticResource DiffTag}}"
                                                               Foreground="White" FontWeight="Bold" FontSize="11"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Key}"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Kind, Converter={StaticResource DiffBrush}}" />
                                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextWrapping="Wrap" Margin="0,1,0,0">
                                                        <Run Text="general:" Foreground="{StaticResource TextSubtleBrush}" />
                                                        <Run Text="{Binding Left, FallbackValue=—, TargetNullValue=—, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextWrapping="Wrap">
                                                        <Run Text="это:" Foreground="{StaticResource TextSubtleBrush}" />
                                                        <Run Text="{Binding Right, FallbackValue=—, TargetNullValue=—, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Actions -->
                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Message}"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />

                        <!-- Auto-pick: only visible/enabled in ZDefree mode (ProviderName == "ZDefree"). -->
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                Command="{Binding AutoPickCommand}"
                                ToolTip="{DynamicResource Strategies.AutoPick.Hint}"
                                Visibility="{Binding CanAutoPick, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource Strategies.AutoPick}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAutoPicking}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Strategies.AutoPicking}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Strategies.OpenFolder}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource ButtonBase}" Command="{Binding InstallCommand}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Strategies.Install}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Strategies.Run}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
