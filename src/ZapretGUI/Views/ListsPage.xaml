<UserControl x:Class="ZapretGUI.Views.ListsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="36,28,36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="{DynamicResource Lists.Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{DynamicResource Lists.Subtitle}"
                           Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- IPSet update card -->
            <Border Grid.Row="1" Style="{StaticResource HeroCard}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Lists.Repo}" Style="{StaticResource H2}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Body}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{DynamicResource Lists.RepoHint}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}"
                                   Text="{Binding IpsetCount, StringFormat='В ipset-all.txt сейчас: {0} строк'}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}"
                                   Text="{Binding Message}"
                                   Visibility="{Binding Message, Converter={StaticResource StringEmpty}}" />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Command="{Binding UpdateHostsCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Lists.CheckHosts}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding UpdateIpsetCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Lists.UpdateIpset}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- User lists -->
            <TextBlock Grid.Row="2" Text="{DynamicResource Lists.UserLists}" Style="{StaticResource MicroCaption}" Margin="2,0,0,10" />

            <UniformGrid Grid.Row="3" Columns="3">
                <UniformGrid.Resources>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Margin" Value="0,0,12,0" />
                    </Style>
                </UniformGrid.Resources>

                <!-- Allowed domains -->
                <Border>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{DynamicResource Lists.General}" Style="{StaticResource H3}" />
                            <TextBlock Text="{DynamicResource Lists.GeneralHint}"
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBox Grid.Row="1" Margin="0,12,0,0"
                                 Text="{Binding General, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="200" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <TextBlock Text="{DynamicResource Common.UnsavedChanges}"
                                       Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource WarningBrush}"
                                       Visibility="{Binding IsDirtyGeneral, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource ButtonBase}" Command="{Binding SaveGeneralCommand}" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Common.Save}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Excluded domains -->
                <Border>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{DynamicResource Lists.Exclude}" Style="{StaticResource H3}" />
                            <TextBlock Text="{DynamicResource Lists.ExcludeHint}"
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBox Grid.Row="1" Margin="0,12,0,0"
                                 Text="{Binding Exclude, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="200" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <TextBlock Text="{DynamicResource Common.UnsavedChanges}"
                                       Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource WarningBrush}"
                                       Visibility="{Binding IsDirtyExclude, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource ButtonBase}" Command="{Binding SaveExcludeCommand}" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Common.Save}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- IPSet exclude -->
                <Border Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{DynamicResource Lists.IpExclude}" Style="{StaticResource H3}" />
                            <TextBlock Text="{DynamicResource Lists.IpExcludeHint}"
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBox Grid.Row="1" Margin="0,12,0,0"
                                 Text="{Binding IpsetExclude, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="200" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <TextBlock Text="{DynamicResource Common.UnsavedChanges}"
                                       Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource WarningBrush}"
                                       Visibility="{Binding IsDirtyIpsetExclude, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource ButtonBase}" Command="{Binding SaveIpsetExcludeCommand}" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Common.Save}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

        </Grid>
    </ScrollViewer>
</UserControl>
