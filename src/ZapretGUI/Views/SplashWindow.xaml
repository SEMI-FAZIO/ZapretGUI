<Window x:Class="ZapretGUI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Width="380" Height="220"
        FontFamily="{DynamicResource UiFont}">
    <Window.Resources>
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Glow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.85" Duration="0:0:1.2" />
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="18"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" Opacity="0.45" ShadowDepth="0" Color="Black" />
        </Border.Effect>

        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="Glow" Width="78" Height="78" CornerRadius="20"
                        Background="{DynamicResource AccentGradientBrush}"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#7C5CFF" Opacity="0.6" BlurRadius="38" ShadowDepth="0" />
                    </Border.Effect>
                    <TextBlock Text="" FontFamily="{DynamicResource IconFont}" FontSize="36"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="Zapret GUI" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock x:Name="StatusText" Text="Загрузка…"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12.5"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Pulse}" />
        </EventTrigger>
    </Window.Triggers>
</Window>
