<Window x:Class="ZapretGUI.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="440"
        FontFamily="{DynamicResource UiFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" Opacity="0.4" ShadowDepth="0" Color="Black" />
        </Border.Effect>

        <StackPanel Margin="28">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBox" Width="40" Height="40" CornerRadius="10"
                        Background="{DynamicResource WarningSoftBrush}">
                    <TextBlock x:Name="IconText" Text="" FontFamily="{DynamicResource IconFont}"
                               FontSize="20"
                               Foreground="{DynamicResource WarningBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Style="{DynamicResource H2}" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="BodyText" Margin="0,14,0,0"
                       Style="{DynamicResource Body}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelBtn" Style="{DynamicResource GhostButton}" Click="OnCancel" MinWidth="100">
                    <TextBlock x:Name="CancelText" Text="{DynamicResource Common.Cancel}" />
                </Button>
                <Button x:Name="ConfirmBtn" Style="{DynamicResource PrimaryButton}"
                        Click="OnConfirm" MinWidth="120" Margin="10,0,0,0">
                    <TextBlock x:Name="ConfirmText" Text="{DynamicResource Common.Confirm}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
