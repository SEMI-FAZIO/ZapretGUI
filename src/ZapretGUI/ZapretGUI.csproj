<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <AssemblyName>ZapretGUI</AssemblyName>
    <RootNamespace>ZapretGUI</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>ZapretGUI contributors</Authors>
    <Product>Zapret GUI</Product>
    <Description>Modern GUI for the zapret-discord-youtube DPI bypass.</Description>
    <Copyright>MIT</Copyright>
    <RepositoryUrl>https://github.com/Flowseal/zapret-discord-youtube</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Flowseal/zapret-discord-youtube</PackageProjectUrl>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- EnableCompressionInSingleFile is set per-publish in CI: .NET 10 SDK rejects it
         on framework-dependent builds (NETSDK1176), so we only pass it when publishing
         the self-contained bundle. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <!-- Legacy codepages (cp866 / cp1251) are not registered in .NET 5+ by
         default. Needed by BatchParser to decode .bat files that aren't UTF-8. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- ZDefree.Core lives in the sibling ZDefree-tools repo. CI checks both repos
         out side-by-side under GUI/. Used by ZDefreeStrategyProvider for native
         JSON-strategy mode (when manifest.json is present in the install root). -->
    <ProjectReference Include="..\..\..\ZDefree-tools\src\ZDefree.Core\ZDefree.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\app.ico" Link="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZapretGUI.Tests" />
  </ItemGroup>

</Project>
