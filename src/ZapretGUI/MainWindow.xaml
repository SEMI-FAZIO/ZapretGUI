<Window x:Class="ZapretGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZapretGUI.ViewModels"
        xmlns:v="clr-namespace:ZapretGUI.Views"
        xmlns:svc="clr-namespace:ZapretGUI.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Zapret GUI"
        Icon="pack://application:,,,/app.ico"
        Height="780" Width="1180"
        MinHeight="620" MinWidth="980"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="{StaticResource BgBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentGradientBrush}">
                        <TextBlock Text="" Style="{StaticResource IconText}"
                                   FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="12" />
                    </Border>
                    <TextBlock Text="Zapret" Margin="10,0,0,0" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="GUI" Margin="6,0,0,0" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StrategyDisplay}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource Caption}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinBtn" Style="{StaticResource TitleBarButton}" Content="" Click="OnMinimize" />
                    <Button x:Name="MaxBtn" Style="{StaticResource TitleBarButton}" Content="" Click="OnMaximize" />
                    <Button x:Name="CloseBtn" Style="{StaticResource TitleBarCloseButton}" Content="" Click="OnClose" />
                </StackPanel>
            </Grid>

            <!-- Main -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource BgDeepBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="18,18,18,6">
                            <TextBlock Text="{DynamicResource Nav.Menu}" Style="{StaticResource MicroCaption}" />
                        </StackPanel>

                        <ListBox Grid.Row="1" Margin="12,6"
                                 ItemsSource="{Binding NavItems}"
                                 SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="10"
                                                        Padding="12,11">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4" />
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Rectangle x:Name="Indicator" Grid.Column="0"
                                                                   Width="3" Height="18"
                                                                   RadiusX="2" RadiusY="2"
                                                                   Fill="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Left"
                                                                   Margin="-8,0,0,0" Opacity="0" />
                                                        <ContentPresenter Grid.Column="1" Grid.ColumnSpan="2"
                                                                          VerticalAlignment="Center"
                                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   VerticalAlignment="Center" Width="20" />
                                        <TextBlock Text="{Binding Title}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13.5" FontWeight="Medium" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Padding="18,14"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                             Fill="{Binding Status.RunState, Converter={StaticResource RunStateBrush}}" />
                                    <TextBlock Text="{Binding Status.RunState, Converter={StaticResource RunStateText}}"
                                               Margin="9,0,0,0" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{Binding Version, StringFormat='Zapret GUI v{0}'}"
                                           Style="{StaticResource MicroCaption}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Content area -->
                <Border Grid.Column="1" Background="{StaticResource BgBrush}">
                    <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{StaticResource BgDeepBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="winws.exe" Style="{StaticResource MicroCaption}" />
                        <Ellipse Width="6" Height="6" Margin="8,0,0,0"
                                 Fill="{Binding Status.WinwsRunning, Converter={StaticResource RunStateBrush}}" />
                        <TextBlock Text="WinDivert" Style="{StaticResource MicroCaption}" Margin="20,0,0,0" />
                        <Ellipse Width="6" Height="6" Margin="8,0,0,0"
                                 Fill="{Binding Status.WinDivertActive, Converter={StaticResource RunStateBrush}}" />
                        <TextBlock Text="Сервис" Style="{StaticResource MicroCaption}" Margin="20,0,0,0" />
                        <Ellipse Width="6" Height="6" Margin="8,0,0,0"
                                 Fill="{Binding Status.ServiceInstalled, Converter={StaticResource RunStateBrush}}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="github.com/Flowseal/zapret-discord-youtube"
                               Style="{StaticResource MicroCaption}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Toast overlay -->
            <ItemsControl Grid.Row="1" Grid.RowSpan="2"
                          ItemsSource="{Binding Source={x:Static svc:ToastService.Instance}, Path=Active}"
                          VerticalAlignment="Bottom" HorizontalAlignment="Right"
                          Margin="0,0,18,18"
                          IsHitTestVisible="False"
                          Panel.ZIndex="1000">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border MinWidth="280" MaxWidth="420"
                                Margin="0,6,0,0"
                                Padding="14,12"
                                CornerRadius="12"
                                Background="{StaticResource SurfaceElevatedBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" Opacity="0.35" ShadowDepth="0" Color="Black" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" VerticalAlignment="Top"
                                        Background="{Binding Kind, Converter={StaticResource ToastBrush}}">
                                    <TextBlock Text="{Binding Kind, Converter={StaticResource ToastIcon}}"
                                               FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Message}"
                                           Margin="12,0,0,0"
                                           Style="{StaticResource Body}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
