<Application x:Class="ZapretGUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:ZapretGUI.Helpers"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette + Strings are swapped at runtime by ThemeService / LocalizationService -->
                <ResourceDictionary Source="Themes/Palette.dark.xaml" />
                <ResourceDictionary Source="Themes/Strings.ru.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Buttons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <h:BoolToVisibilityConverter         x:Key="BoolToVis" />
            <h:NullToVisibilityConverter         x:Key="NullToVis" />
            <h:EqualsConverter                   x:Key="EqualsConv" />
            <h:RunStateToTextConverter           x:Key="RunStateText" />
            <h:RunStateToBrushConverter          x:Key="RunStateBrush" />
            <h:IsRunningConverter                x:Key="IsRunning" />
            <h:DiagnosticLevelToBrushConverter   x:Key="DiagLevelBrush" />
            <h:DiagnosticLevelToBgConverter      x:Key="DiagLevelBg" />
            <h:DiagnosticLevelToIconConverter    x:Key="DiagLevelIcon" />
            <h:StringEmptyConverter              x:Key="StringEmpty" />
            <h:BoolToTextConverter               x:Key="BoolText" />
            <h:CountToVisibilityConverter        x:Key="CountToVis" />
            <h:ToastKindToBrushConverter         x:Key="ToastBrush" />
            <h:ToastKindToIconConverter          x:Key="ToastIcon" />
            <h:DiffKindToBrushConverter          x:Key="DiffBrush" />
            <h:DiffKindToTagConverter            x:Key="DiffTag" />

            <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextStyle}" />
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}" />
            <Style TargetType="ListBox" BasedOn="{StaticResource DefaultListBox}" />
            <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
